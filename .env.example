# Required
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Optional — enables cloud embeddings for semantic recall.
# If unset, the server falls back to a local CPU model (bge-small, ~30MB,
# downloaded on first use). Semantic recall works either way.
VOYAGE_API_KEY=

# Server config (all optional)
PORT=3000
DATABASE_PATH=./data/chat.db

# Client-side time zone hint for ledger rendering (defaults to server tz)
# TZ=Asia/Kolkata
